{
  "name": "app-dock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:common": "pnpm --filter common build",
    "postinstall": "pnpm run build:common",
    "dev": "pnpm run build:common && node scripts/gen-micro-apps.js && npm run dev --workspace=main-app",
    "build": "node scripts/gen-micro-apps.js --build && vue-tsc -b && pnpm --filter common build && pnpm --filter main-app build",
    "build:select": "node scripts/select-projects.mjs build",
    "dev:select": "node scripts/select-projects.mjs dev",
    "create:app": "node scripts/create-application.mjs",
    "delete:app": "node scripts/delete-application.mjs",
    "preview": "vite preview",
    "gen-micro-apps": "node scripts/gen-micro-apps.js",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:scripts",
    "fix": "pnpm run format && pnpm run lint:fix",
    "lint": "eslint \"{main-app,application,common,scripts,vite,packages}/**/*.{js,jsx,ts,tsx,vue,mjs,cjs}\" \"*.config.{js,ts,mjs,cjs}\"",
    "lint:fix": "eslint \"{main-app,application,common,scripts,vite,packages}/**/*.{js,jsx,ts,tsx,vue,mjs,cjs}\" \"*.config.{js,ts,mjs,cjs}\" --fix",
    "format": "prettier \"{main-app,application,common,scripts,vite,packages}/**/*.{js,jsx,ts,tsx,vue,mjs,cjs,json,md,css,less,scss,html,yml,yaml}\" \"*.{js,ts,mjs,cjs,json,md,yml,yaml}\" --write",
    "format:check": "prettier \"{main-app,application,common,scripts,vite,packages}/**/*.{js,jsx,ts,tsx,vue,mjs,cjs,json,md,css,less,scss,html,yml,yaml}\" \"*.{js,ts,mjs,cjs,json,md,yml,yaml}\" --check",
    "typecheck": "pnpm --filter common build && vue-tsc -b --noEmit --pretty false",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "supabase:reset": "node scripts/supabase-local.mjs reset",
    "supabase:status": "node scripts/supabase-local.mjs status",
    "test:scripts": "node scripts/sync-cli-template.mjs && node --test scripts/*.test.mjs packages/create-app-dock/test/*.test.mjs"
  },
  "workspaces": [
    "main-app",
    "application/*",
    "common"
  ],
  "packageManager": "pnpm@9.14.1",
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "common": "workspace:^",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "less": "^4.9.1",
    "lodash.merge": "^4.6.2",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "three": "^0.186.1",
    "vite-plugin-simple-html": "^1.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^26.6.4",
    "@types/postcss-normalize": "^9.0.4",
    "@types/three": "^0.186.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "chalk": "^6.0.1",
    "cssnano": "^9.4.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "node-module-type": "^1.0.4",
    "postcss": "^8.5.29",
    "postcss-normalize": "^13.0.1",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-qiankun": "^1.0.15",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.12"
  }
}
