{
  "name": "vue-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-micro-apps.js && npm run dev --workspace=main-app",
    "build": "node scripts/gen-micro-apps.js --build && vue-tsc -b && pnpm --filter common build && pnpm --filter main-app build",
    "build:select": "node scripts/select-projects.mjs build",
    "dev:select": "node scripts/select-projects.mjs dev",
    "create:app": "node scripts/create-application.mjs",
    "delete:app": "node scripts/delete-application.mjs",
    "preview": "vite preview",
    "gen-micro-apps": "node scripts/gen-micro-apps.js",
    "lint": "eslint \"{main-app,application,common,scripts,vite}/**/*.{js,jsx,ts,tsx,vue,mjs,cjs}\" \"*.config.{js,ts,mjs,cjs}\"",
    "lint:fix": "eslint \"{main-app,application,common,scripts,vite}/**/*.{js,jsx,ts,tsx,vue,mjs,cjs}\" \"*.config.{js,ts,mjs,cjs}\" --fix",
    "format": "prettier \"{main-app,application,common,scripts,vite}/**/*.{js,jsx,ts,tsx,vue,mjs,cjs,json,md,css,less,scss,html,yml,yaml}\" \"*.{js,ts,mjs,cjs,json,md,yml,yaml}\" --write",
    "format:check": "prettier \"{main-app,application,common,scripts,vite}/**/*.{js,jsx,ts,tsx,vue,mjs,cjs,json,md,css,less,scss,html,yml,yaml}\" \"*.{js,ts,mjs,cjs,json,md,yml,yaml}\" --check",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "workspaces": [
    "main-app",
    "application/*",
    "common"
  ],
  "packageManager": "pnpm@9.14.1",
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "common": "workspace:^",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "less": "^4.4.0",
    "lodash.merge": "^4.6.2",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "three": "^0.182.0",
    "vite-plugin-simple-html": "^1.0.1",
    "vue": "^3.5.17",
    "vue-router": "4"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.1",
    "@eslint/js": "^9.31.0",
    "@types/babel__traverse": "^7.20.7",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^24.0.14",
    "@types/postcss-normalize": "^9.0.4",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.23",
    "chalk": "^5.4.1",
    "cssnano": "^7.1.2",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^16.3.0",
    "node-module-type": "^1.0.2",
    "postcss": "^8.5.6",
    "postcss-normalize": "^13.0.1",
    "postcss-preset-env": "^10.6.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.5",
    "vite-plugin-qiankun": "^1.0.15",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^2.2.12"
  }
}
